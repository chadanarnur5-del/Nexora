<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>NEXORA — Shaping Digital Realities</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Inter:wght@300;400&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#04030a; --ink:#f4f2fb; --dim:#a9a8bd; --line:rgba(255,255,255,.55);
  --serif:'Cormorant Garamond','Cormorant',Georgia,'Times New Roman',serif;
  --sans:'Inter','Helvetica Neue',Arial,sans-serif;
  color-scheme:dark; box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:inherit}
html,body{height:100%;margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);overflow:hidden}
a{color:inherit;text-decoration:none}
a:focus-visible,button:focus-visible{outline:1px solid #9db0ff;outline-offset:4px}
.hero{position:relative;height:100%;min-height:520px;overflow:hidden;
  background:
   radial-gradient(60% 55% at 62% 48%,rgba(70,50,170,.34),transparent 70%),
   radial-gradient(40% 50% at 88% 12%,rgba(60,70,190,.28),transparent 70%),
   linear-gradient(180deg,#050410,#04030a 60%,#07051a)}
.beam{position:absolute;top:-10%;right:2%;width:46%;height:90%;
  background:linear-gradient(200deg,rgba(130,140,255,.34),rgba(90,80,220,.12) 45%,transparent 75%);
  clip-path:polygon(55% 0,100% 0,100% 70%,0 100%);filter:blur(26px);opacity:.8}
.stage{position:absolute;inset:0}
.stage svg{width:100%;height:100%;display:block}
canvas{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.vignette{position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(120% 100% at 60% 50%,transparent 55%,rgba(2,1,8,.75))}
.float{animation:fl 9s ease-in-out infinite;transform-box:fill-box;transform-origin:center}
.f2{animation-duration:12s;animation-delay:-3s}.f3{animation-duration:7s;animation-delay:-5s}.f4{animation-duration:14s;animation-delay:-8s}
@keyframes fl{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-14px) rotate(.8deg)}}
.glint{animation:gl 5s ease-in-out infinite}
@keyframes gl{0%,100%{opacity:.55}50%{opacity:1}}

/* nav */
header{position:absolute;inset:28px 34px auto 34px;display:flex;align-items:center;justify-content:space-between;z-index:5}
.logo{display:flex;align-items:center;gap:12px;font-size:13px;letter-spacing:.28em;font-weight:400}
nav{position:absolute;left:51%;transform:translateX(-50%);display:flex;gap:58px}
nav a{position:relative;font-size:11px;letter-spacing:.14em;text-transform:uppercase;padding-bottom:12px;white-space:nowrap}
nav a small{font-size:9px;color:var(--dim);margin-left:12px;letter-spacing:.1em}
nav a::after{content:"";position:absolute;left:50%;bottom:0;width:3px;height:3px;border-radius:50%;background:#fff;transform:translateX(-50%)}
.cta{border:1px solid var(--line);border-radius:999px;padding:9px 18px;font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;transition:background .3s,border-color .3s}
.cta:hover{background:rgba(255,255,255,.1);border-color:#fff}

/* copy */
.copy{position:absolute;left:8.4%;top:32.5%;z-index:4;max-width:min(520px,80%)}
h1{margin:0;font-family:var(--serif);font-weight:400;font-size:clamp(2.6rem,4.45vw,4.6rem);line-height:1.08;letter-spacing:-.005em}
.copy p{margin:34px 0 0;font-size:clamp(12.5px,1.07vw,14.5px);font-weight:300;line-height:1.65;color:var(--dim)}
.explore{display:inline-flex;align-items:center;gap:22px;margin-top:48px;font-size:10px;letter-spacing:.18em;text-transform:uppercase}
.explore svg{width:30px;height:7px;transition:transform .4s}
.explore:hover svg{transform:translateX(8px)}
.intro>*{opacity:0;transform:translateY(14px);animation:in 1.1s cubic-bezier(.2,.7,.2,1) forwards}
.intro>*:nth-child(2){animation-delay:.25s}.intro>*:nth-child(3){animation-delay:.5s}
@keyframes in{to{opacity:1;transform:none}}

/* right scroll rail */
.rail{position:absolute;right:30px;top:33%;display:flex;flex-direction:column;align-items:center;gap:14px;z-index:4;font-size:9px;letter-spacing:.3em}
.rail .v{writing-mode:vertical-rl;color:var(--dim)}
.rail .track{position:relative;width:1px;height:140px;background:var(--line)}
.rail .track i{position:absolute;left:50%;width:11px;height:11px;margin-left:-5.5px;border:1px solid var(--line);border-radius:50%;background:var(--bg)}
.rail .track i:first-child{top:28%}.rail .track i:last-child{top:90%}
.count{margin-top:34px;display:flex;flex-direction:column;gap:12px;letter-spacing:.12em;text-align:center}
.count span:last-child{color:var(--dim)}

/* footer */
footer{position:absolute;left:24px;right:46px;bottom:22px;display:flex;align-items:center;z-index:4;font-size:9.5px;letter-spacing:.2em;text-transform:uppercase}
.snd{flex:none;width:34px;height:34px;border:1px solid var(--line);border-radius:50%;background:none;color:#fff;display:grid;place-items:center;cursor:pointer}
.ln{height:1px;background:var(--line);opacity:.8}
footer .a{width:9%;margin-left:3.5%}
footer .b{flex:1;margin-left:4.5%}
footer .c{flex:1.7}
footer .t{margin:0 14px;white-space:nowrap}

@media (max-width:820px){
  header{inset:20px 20px auto 20px}
  nav,.rail{display:none}
  .stage{inset:0 0 auto 0;height:64%}
  .copy{left:24px;top:auto;bottom:17%;max-width:calc(100% - 48px)}
  h1{font-size:clamp(2.4rem,11vw,3.4rem)}
  .copy p{margin-top:20px;font-size:13px}
  .explore{margin-top:30px}
  footer{left:18px;right:18px;bottom:18px}
  footer .a,footer .c,.snd{display:none}
  footer .b{margin:0}
  footer .t{font-size:8px;margin:0 10px}
}
@media (prefers-reduced-motion:reduce){.float,.glint,.intro>*{animation:none;opacity:1;transform:none}}
</style>
</head>
<body>
<main class="hero" id="home">
  <div class="beam"></div>
  <div class="stage">
    <svg viewBox="0 0 1290 860" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <linearGradient id="gA" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#8d9bff"/><stop offset=".45" stop-color="#6247f0"/><stop offset="1" stop-color="#26217a"/></linearGradient>
        <linearGradient id="gB" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f0a98a"/><stop offset=".5" stop-color="#a26bd8"/><stop offset="1" stop-color="#4a36a8"/></linearGradient>
        <linearGradient id="gC" x1="1" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7a4ad8"/><stop offset=".6" stop-color="#34208a"/><stop offset="1" stop-color="#150f3a"/></linearGradient>
        <linearGradient id="gD" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#3c2a86"/><stop offset="1" stop-color="#120b2c"/></linearGradient>
        <linearGradient id="gE" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#9aa6ff"/><stop offset="1" stop-color="#3a3fb8"/></linearGradient>
        <linearGradient id="gF" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#b3a2e6"/><stop offset="1" stop-color="#4b3a9a"/></linearGradient>
        <linearGradient id="gR" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#3a3270"/><stop offset="1" stop-color="#110d28"/></linearGradient>
        <radialGradient id="halo"><stop offset="0" stop-color="#7d5cff" stop-opacity=".42"/><stop offset="1" stop-color="#7d5cff" stop-opacity="0"/></radialGradient>
        <filter id="glow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="9" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
        <filter id="blur6"><feGaussianBlur stdDeviation="7"/></filter>
        <filter id="blur12"><feGaussianBlur stdDeviation="14"/></filter>
      </defs>

      <!-- blurred foreground rocks -->
      <g data-d="26"><polygon points="60,860 100,670 270,620 410,740 440,860" fill="#1d1944" filter="url(#blur6)" opacity=".9"/>
      <polygon points="850,860 880,600 1010,570 1140,740 1120,860" fill="#34295e" filter="url(#blur12)" opacity=".75"/></g>

      <ellipse cx="690" cy="470" rx="330" ry="360" fill="url(#halo)"/>

      <!-- dark rocks -->
      <g data-d="10"><g class="float f4">
        <polygon points="915,70 975,40 972,102 930,122" fill="#2b2133" stroke="#e08a4e" stroke-opacity=".35"/>
        <polygon points="1050,50 1085,70 1070,120 1040,100" fill="#262040"/>
        <polygon points="1002,95 1032,85 1036,126 1010,132" fill="#2a2144"/>
        <polygon points="880,228 960,220 996,262 942,312 905,286" fill="#2c2850" stroke="#c98a6a" stroke-opacity=".3"/>
        <polygon points="880,228 960,220 940,262" fill="#4a4478" opacity=".6"/>
      </g></g>
      <g data-d="18"><g class="float f2">
        <polygon points="372,642 482,590 572,666 522,724 396,714" fill="url(#gR)" stroke="#8a6aa8" stroke-opacity=".35"/>
        <polygon points="482,590 572,666 522,640" fill="#4a3f8a" opacity=".7"/>
        <polygon points="190,594 272,570 252,644 200,628" fill="#1b1840"/>
        <polygon points="395,500 466,445 470,470 412,513" fill="#6b4a5c" stroke="#ff9a5a" stroke-opacity=".6"/>
        <polygon points="533,338 562,334 552,360 538,356" fill="#35307a" opacity=".8"/>
        <polygon points="492,388 512,402 500,418" fill="#7a5a70" opacity=".8"/>
      </g></g>

      <!-- upper-left crystal -->
      <g data-d="22"><g class="float f3" filter="url(#glow)">
        <polygon points="612,148 692,182 636,222 560,238" fill="#8da0ff"/>
        <polygon points="560,238 636,222 640,392 528,262" fill="url(#gA)"/>
        <polygon points="636,222 692,182 740,242 735,300 640,392" fill="url(#gC)"/>
        <polyline points="528,262 560,238 612,148 692,182 740,242 735,300" fill="none" stroke="#cfd6ff" stroke-opacity=".75" stroke-width="1.2"/>
      </g></g>

      <!-- thin shard -->
      <g data-d="30"><g class="float">
        <polygon points="788,102 868,208 835,222" fill="#9ea9de"/>
        <polygon points="788,102 835,222 822,308" fill="#4a4f9c"/>
        <polygon points="868,208 835,222 822,308" fill="#6d73c0" opacity=".7"/>
      </g></g>

      <!-- main crystal -->
      <g data-d="38"><g class="float f2" filter="url(#glow)">
        <polygon points="795,255 520,478 735,590" fill="url(#gA)"/>
        <polygon points="795,255 735,590 808,572" fill="url(#gB)"/>
        <polygon points="520,478 735,590 690,742" fill="url(#gC)"/>
        <polygon points="735,590 808,572 690,742" fill="url(#gD)"/>
        <polygon points="795,255 650,395 735,590" fill="#fff" opacity=".12"/>
        <polygon points="560,500 735,590 640,610" fill="#ff9a5a" opacity=".28"/>
        <polyline points="795,255 520,478 735,590 808,572 795,255" fill="none" stroke="#e6e0ff" stroke-opacity=".85" stroke-width="1.4"/>
        <polyline points="520,478 735,590" fill="none" stroke="#ffb27a" stroke-width="2.6" class="glint"/>
        <polyline points="735,590 690,742 808,572" fill="none" stroke="#b28cff" stroke-opacity=".7" stroke-width="1.2"/>
      </g></g>

      <!-- small glowing crystal -->
      <g data-d="46"><g class="float f3" filter="url(#glow)">
        <polygon points="815,412 840,376 868,370 880,380 850,416" fill="#c4b6ff"/>
        <polygon points="840,376 868,370 850,392" fill="#fff" opacity=".85"/>
      </g></g>

      <!-- right crystal + lower shard -->
      <g data-d="30"><g class="float f4">
        <polygon points="1048,438 1098,396 1225,496 1135,540" fill="url(#gF)"/>
        <polygon points="1048,438 1135,540 1076,506" fill="#2d2460"/>
        <polyline points="1048,438 1098,396 1225,496" fill="none" stroke="#e8e4ff" stroke-opacity=".8" stroke-width="1.2"/>
        <polygon points="872,505 896,528 832,640 806,636" fill="url(#gE)" opacity=".85"/>
        <polygon points="732,660 764,672 800,790 770,780" fill="url(#gE)" opacity=".55"/>
      </g></g>
    </svg>
    <canvas id="dust"></canvas>
  </div>
  <div class="vignette"></div>

  <header>
    <a class="logo" href="#home" aria-label="NEXORA home">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="#fff" stroke-width="1.4"><rect x="1" y="1" width="16" height="16"/><path d="M5 13V5l8 8V5" stroke-linejoin="round"/></svg>NEXORA
    </a>
    <nav aria-label="Main">
      <a href="#work">Work<small>—04</small></a>
      <a href="#about">About<small>—02</small></a>
      <a href="#services">Services<small>—03</small></a>
      <a href="#global">Global<small>—05</small></a>
    </nav>
    <a class="cta" href="#contact">Contact us</a>
  </header>

  <section class="copy intro">
    <h1>Shaping<br>Digital Realities</h1>
    <p>We craft immersive digital experiences<br>that inspire, engage, and transform brands.</p>
    <a class="explore" href="#work">Explore our work
      <svg viewBox="0 0 30 7" fill="none" stroke="#fff"><path d="M0 3.5h29M25 .5l4 3-4 3"/></svg></a>
  </section>

  <aside class="rail" aria-hidden="true">
    <span class="v">SCROLL</span>
    <div class="track"><i></i><i></i></div>
    <div class="count"><span>01</span><span>05</span></div>
  </aside>

  <footer>
    <button class="snd" id="snd" aria-label="Sound off" aria-pressed="false">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6"><path d="M3 9v6h4l5 4V5L7 9z"/></svg></button>
    <span class="ln a"></span><span class="ln b"></span>
    <span class="t">Innovation · Creativity · Impact</span>
    <span class="ln c"></span>
  </footer>
</main>

<script>
(function(){
  var reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
  // mouse parallax for crystal groups
  var groups=[].slice.call(document.querySelectorAll('[data-d]'));
  var tx=0,ty=0,cx=0,cy=0;
  if(!reduce){
    addEventListener('mousemove',function(e){tx=e.clientX/innerWidth-.5;ty=e.clientY/innerHeight-.5});
    (function loop(){
      cx+=(tx-cx)*.06;cy+=(ty-cy)*.06;
      groups.forEach(function(g){var d=+g.getAttribute('data-d');
        g.style.transform='translate('+(-cx*d)+'px,'+(-cy*d)+'px)'});
      requestAnimationFrame(loop);
    })();
  }
  // dust particles
  var c=document.getElementById('dust'),x=c.getContext('2d'),W,H,P=[];
  var cols=['255,170,100','255,150,80','160,175,255','255,255,255','190,150,255'];
  function size(){var r=devicePixelRatio||1;W=c.clientWidth;H=c.clientHeight;c.width=W*r;c.height=H*r;x.setTransform(r,0,0,r,0,0)}
  function make(){var n=W<820?70:150;P=[];
    for(var i=0;i<n;i++){
      var side=Math.random()<.72;
      P.push({x:(side?.55+Math.random()*.45:Math.random())*W,y:Math.random()*H,
        r:Math.random()*1.5+.3,vx:(Math.random()-.5)*.12,vy:-Math.random()*.16-.02,
        a:Math.random()*Math.PI*2,s:Math.random()*.02+.005,c:cols[Math.floor(Math.random()*cols.length)]});
    }}
  function draw(){
    x.clearRect(0,0,W,H);
    P.forEach(function(p){
      if(!reduce){p.x+=p.vx;p.y+=p.vy;p.a+=p.s;
        if(p.y<-5)p.y=H+5;if(p.x<-5)p.x=W+5;if(p.x>W+5)p.x=-5;}
      var o=.25+.55*Math.abs(Math.sin(p.a));
      x.beginPath();x.fillStyle='rgba('+p.c+','+o.toFixed(2)+')';x.arc(p.x,p.y,p.r,0,6.283);x.fill();
    });
    if(!reduce)requestAnimationFrame(draw);
  }
  size();make();draw();
  addEventListener('resize',function(){size();make();if(reduce)draw()});
  // sound toggle (visual only)
  var s=document.getElementById('snd');
  s.addEventListener('click',function(){var on=s.getAttribute('aria-pressed')!=='true';
    s.setAttribute('aria-pressed',on);s.style.background=on?'rgba(255,255,255,.14)':'none'});
})();
</script>
</body>
</html>
